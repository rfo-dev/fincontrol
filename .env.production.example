# Production env template for Hostinger VPS
# Copy to .env next to docker-compose.prod.yml on the server

POSTGRES_USER=fincontrol
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fincontrol

JWT_SECRET=change-me-long-random-jwt-secret
AI_ENCRYPTION_KEY=change-me-encryption-key

CORS_ORIGIN=https://financial.cubotechbr.com.br
PUBLIC_APP_URL=https://financial.cubotechbr.com.br
API_PUBLIC_URL=https://financial.cubotechbr.com.br
WEB_PORT=80

# Meta / WhatsApp
META_APP_ID=1735269627742980
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=3675948592581668
META_GRAPH_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=fincontrol-wa-verify-change-me

# Images (optional overrides)
# API_IMAGE=ghcr.io/rfo-dev/fincontrol-api:latest
# WEB_IMAGE=ghcr.io/rfo-dev/fincontrol-web:latest
